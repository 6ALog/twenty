# Non-secret runtime settings for the Cloud Run server service.
# Store secrets such as PG_DATABASE_URL, REDIS_URL, ENCRYPTION_KEY, and
# OAuth credentials in Secret Manager, not in this file.

# Server Cloud Run service environment.

NODE_PORT=3000
SERVER_URL=https://crm.6alogic.com
STORAGE_TYPE=S_3
# Fill these when you choose an S3-compatible bucket for persistent uploads.
# STORAGE_S3_REGION=us-central1
# STORAGE_S3_NAME=your-bucket-name
# STORAGE_S3_ENDPOINT=https://storage.googleapis.com

DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false

# Optional if you choose environment-only configuration instead of Twenty's
# Admin Panel configuration variable storage.
# MESSAGING_PROVIDER_GMAIL_ENABLED=true
# CALENDAR_PROVIDER_GOOGLE_ENABLED=true
# AUTH_GOOGLE_CALLBACK_URL=https://crm.6alogic.com/auth/google/redirect
# AUTH_GOOGLE_APIS_CALLBACK_URL=https://crm.6alogic.com/auth/google-apis/get-access-token
